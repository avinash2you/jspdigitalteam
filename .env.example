# Environment & General
ENVIRONMENT=development
PROJECT_NAME="JSP Digital Intelligence Platform API"

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jsp_intel

# Authentication (Clerk)
CLERK_SECRET_KEY=sk_test_placeholder_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_placeholder_publishable_key
CLERK_JWT_ISSUER=https://example.clerk.accounts.dev

# Storage (Cloudflare R2 / S3-compatible)
STORAGE_BACKEND=r2
R2_ACCOUNT_ID=placeholder_r2_account_id
R2_ACCESS_KEY_ID=placeholder_r2_access_key_id
R2_SECRET_ACCESS_KEY=placeholder_r2_secret_access_key
R2_BUCKET_NAME=jsp-intel-assets-private
R2_ENDPOINT_URL=https://placeholder_account_id.r2.cloudflarestorage.com

# OCR Service
OCR_BACKEND=tesseract
TESSERACT_CMD=/usr/bin/tesseract

# AI Service (Free Tier for public docs only)
AI_BACKEND=gemini_free
GEMINI_API_KEY=placeholder_gemini_api_key

# Search Service
SEARCH_BACKEND=postgres_hybrid
